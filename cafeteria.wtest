class NivelFalso {
    const dichos = []
    var restado = 0
    var sumado = 0
    var tiempoDescontado = false

    method dichos() = dichos
    method ultimoDicho() = dichos.last()
    method restado() = restado
    method sumado() = sumado
    method tiempoDescontado() = tiempoDescontado

    method decir(texto) { dichos.add(texto) }
    method restarTiempo(cantidad) { restado += cantidad }
    method sumarTiempo(cantidad) { sumado += cantidad }
    method descontarTiempo() { tiempoDescontado = true }
    method ingredienteCorrecto() { }
}

class EscenaFalsa {
    const dichos = []

    method ultimoDicho() = dichos.last()
    method decir(texto) { dichos.add(texto) }
    method sonarAcierto() { }
    method prepararPara(cliente) { }
    method visuales() = []
}

class JuegoFalso {
    const elementos = []
    const nivel = new NivelFalso()

    method elementos() = elementos
    method nivelActual() = nivel

    method clickearElemento(posicion, lista) { elementos.addAll(lista) }
    method verificarNivel() { }
}

// visuales e ingredientes

test "un ingrediente tiene imagen y texto" {
    assert.equals("juegor1/cafe.png", cafe.image())
    assert.equals("café", cafe.textoParaMostrar())
    assert.equals("agua", agua.textoParaMostrar())
}

test "las subclases de Visual tienen su posicion por defecto" {
    const unEstudiante = new EstudianteSentado(rutaImagen = "estudiante.png")
    const unPedido = new PedidoReferencia(rutaImagen = "pedido.png")
    const unaPantalla = new PantallaResultado(rutaImagen = "resultado.png")
    assert.equals(game.at(6, 2).x(), unEstudiante.position().x())
    assert.equals(game.at(6, 2).y(), unEstudiante.position().y())
    assert.equals(game.at(8, 2).x(), unPedido.position().x())
    assert.equals(game.at(8, 2).y(), unPedido.position().y())
    assert.equals(game.origin().x(), unaPantalla.position().x())
    assert.equals(game.origin().y(), unaPantalla.position().y())
}
test "un visual se puede mover de lugar" {
    const unVisual = new Visual(rutaImagen = "x.png")
    assert.equals(game.origin().x(), unVisual.position().x())
    unVisual.moverA(game.at(4, 5))
    assert.equals(4, unVisual.position().x())
    assert.equals(5, unVisual.position().y())
}
describe "la grilla reparte lugares" {
    const grilla = new Grilla(columnas = [1, 2], filas = [5, 4])

    test "sus celdas van fila por fila, de izquierda a derecha" {
        assert.equals(4, grilla.capacidad())
        assert.equals([1, 2, 1, 2], grilla.celdas().map({ celda => celda.x() }))
        assert.equals([5, 5, 4, 4], grilla.celdas().map({ celda => celda.y() }))
    }

    test "no se rompe si hay mas visuales que celdas, ni si no hay ninguno" {
        const seis = (1 .. 6).map({ n => new Visual(rutaImagen = n.toString() + ".png") })
        grilla.acomodar(seis)
        grilla.acomodar([])
        assert.equals(4, grilla.capacidad())
    }
}
describe "una escena se arma a partir del pedido" {
    const clienteDePrueba = new ClientePaciente(pedido = new Pedido(recetas = [cafeConMedialunas, hamburguesaCompleta]))
    const escenaDePrueba = new Escena(
        visualCliente = mariaMostrador,
        extras = hamburgueseria + bebidas,
        pantallaCorrecto = pedidoCorrecto2,
        pantallaSinTiempo = pedidoFueraDeTiempo2
    )

    test "ofrece todo lo que el pedido necesita, aunque no sea de su panel original" {
        escenaDePrueba.prepararPara(clienteDePrueba)
        assert.that(clienteDePrueba.ingredientesPedidos().all({ ingrediente => escenaDePrueba.ingredientes().contains(ingrediente) }))
        assert.that(escenaDePrueba.ingredientes().contains(cafe))
        assert.that(escenaDePrueba.ingredientes().contains(carne))
    }

    test "tambien ofrece los extras, sin repetir y sin pasarse del panel" {
        escenaDePrueba.prepararPara(clienteDePrueba)
        assert.that(escenaDePrueba.ingredientes().contains(quesoAzul))
        assert.equals(escenaDePrueba.ingredientes().asSet().size(), escenaDePrueba.ingredientes().size())
        assert.that(escenaDePrueba.ingredientes().size() <= panel.capacidad())
    }

    test "cada ingrediente queda en una celda distinta" {
        escenaDePrueba.prepararPara(clienteDePrueba)
        const lugares = escenaDePrueba.ingredientes().map({ ingrediente => ingrediente.position().x() * 100 + ingrediente.position().y() })
        assert.equals(lugares.asSet().size(), lugares.size())
    }

    test "los pedido de referencia se acomodan en la vitrina" {
        escenaDePrueba.prepararPara(clienteDePrueba)
        assert.equals([cafeConMedialunas, hamburguesaCompleta], escenaDePrueba.enLaVitrina())
        assert.equals([8, 10], escenaDePrueba.enLaVitrina().map({ receta => receta.position().x() }))
    }

    test "prepararla de nuevo no duplica los ingredientes" {
        escenaDePrueba.prepararPara(clienteDePrueba)
        const cuantos = escenaDePrueba.ingredientes().size()
        escenaDePrueba.prepararPara(clienteDePrueba)
        assert.equals(cuantos, escenaDePrueba.ingredientes().size())
    }
}


// herencia

describe "clientes" {
    const paciente = new ClientePaciente(pedido = new Pedido (recetas =[cafeConMedialunas]))
    const exigente = new ClienteExigente(pedido = new Pedido (recetas = [cafeConMedialunas]))
    const copado = new ClienteCopado(pedido = new Pedido (recetas =[cafeConMedialunas]))
    const clientes = [paciente, exigente, copado]
    const nivelFalso = new NivelFalso()

    test "todos los clientes comparten la logica del pedido" {
        clientes.forEach({ cliente => cliente.recibirIngrediente(cafe, nivelFalso) })
        assert.that(clientes.all({ cliente => not cliente.resultadoCorrecto() }))
        clientes.forEach({ cliente => cliente.recibirIngrediente(medialunas, nivelFalso) })
        assert.that(clientes.all({ cliente => cliente.resultadoCorrecto() }))
        clientes.forEach({ cliente => cliente.reiniciar() })
        assert.that(clientes.all({ cliente => not cliente.resultadoCorrecto() }))
    }

    test "solo el exigente resta tiempo en el primer error" {
        paciente.recibirIngrediente(agua, nivelFalso)
        copado.recibirIngrediente(agua, nivelFalso)
        assert.equals(0, nivelFalso.restado())
        exigente.recibirIngrediente(agua, nivelFalso)
        assert.equals(3, nivelFalso.restado())
    }

    test "el exigente resta cada vez mas tiempo" {
        exigente.recibirIngrediente(agua, nivelFalso)
        exigente.recibirIngrediente(agua, nivelFalso)
        assert.equals(8, nivelFalso.restado())
    }

    test "el paciente aguanta 2 errores y al tercero resta tiempo" {
        3.times({ i => paciente.recibirIngrediente(agua, nivelFalso) })
        assert.equals(2, nivelFalso.restado())
    }

    test "al reiniciar, el paciente vuelve a tener paciencia" {
        3.times({ i => paciente.recibirIngrediente(agua, nivelFalso) })
        paciente.reiniciar()
        paciente.recibirIngrediente(agua, nivelFalso)
        assert.equals(2, nivelFalso.restado())
    }

    test "el copado suma tiempo por cada acierto" {
        copado.recibirIngrediente(cafe, nivelFalso)
        copado.recibirIngrediente(medialunas, nivelFalso)
        assert.equals(2, nivelFalso.sumado())
    }

    test "el copado avisa que le falta cuando le dan algo que no pidio" {
        copado.recibirIngrediente(agua, nivelFalso)
        assert.equals("No pasa nada, me falta café", nivelFalso.ultimoDicho())
    }
}

// estados

describe "estados" {
    const juegoFalso = new JuegoFalso()

    test "cada estado con boton escucha solo a su boton" {
        [estadoSinTiempo, estadoCorrecto, estadoFinal].forEach({ estado => estado.procesarClick(juegoFalso, game.at(0, 0)) })
        assert.equals([botonReintentar, botonSeguir, botonReiniciar], juegoFalso.elementos())
    }

    test "solo estadoJugando descuenta tiempo" {
        estadoSinTiempo.pasoUnSegundo(juegoFalso)
        estadoCorrecto.pasoUnSegundo(juegoFalso)
        estadoFinal.pasoUnSegundo(juegoFalso)
        assert.notThat(juegoFalso.nivelActual().tiempoDescontado())

        estadoJugando.pasoUnSegundo(juegoFalso)
        assert.that(juegoFalso.nivelActual().tiempoDescontado())
    }
}

// niveles

describe "niveles" {
    const escena = new EscenaFalsa()
    const unCliente = new ClientePaciente(pedido = new Pedido(recetas = [cafeConMedialunas]))
    const nivel = new Nivel(cliente = unCliente, escena = escena, reloj = new Temporizador(segundosIniciales = 30))

    test "al iniciar, arranca el reloj y el cliente dice su pedido" {
        nivel.iniciar()
        assert.equals(30, nivel.tiempoRestante())
        assert.equals("Hola, un café con medialunas", escena.ultimoDicho())
    }

    test "el nivel resta y suma tiempo" {
        nivel.iniciar()
        nivel.restarTiempo(5)
        nivel.sumarTiempo(1)
        nivel.descontarTiempo()
        assert.equals(25, nivel.tiempoRestante())
    }

    test "el tiempo no baja de 0" {
        nivel.iniciar()
        nivel.restarTiempo(100)
        assert.equals(0, nivel.tiempoRestante())
        assert.that(nivel.seAcaboElTiempo())
    }

    test "enviar el pedido completo completa el nivel" {
        nivel.iniciar()
        nivel.recibirIngrediente(cafe)
        nivel.recibirIngrediente(medialunas)
        nivel.enviarPedido()
        assert.that(nivel.pedidoCompleto())
    }

    test "enviar el pedido incompleto no completa el nivel" {
        nivel.iniciar()
        nivel.recibirIngrediente(cafe)
        nivel.enviarPedido()
        assert.notThat(nivel.pedidoCompleto())
        assert.equals("Mi pedido está incompleto", escena.ultimoDicho())
    }

    test "al reintentar, el nivel arranca de cero" {
        nivel.iniciar()
        nivel.recibirIngrediente(cafe)
        nivel.recibirIngrediente(medialunas)
        nivel.enviarPedido()
        nivel.restarTiempo(10)
        nivel.iniciar()
        assert.notThat(nivel.pedidoCompleto())
        assert.equals(30, nivel.tiempoRestante())
    }
}

describe "fabricaDeNiveles" {
    test "crea los niveles con las escenas en orden" {
        const niveles = fabricaDeNiveles.crearNiveles(4)
        assert.equals([escena1, escena2, escena3, escena1], niveles.map({ nivel => nivel.escena() }))
    }

    test "cada nivel dura menos, pero con un minimo" {
        assert.equals(30, fabricaDeNiveles.segundosDelNivel(1))
        assert.equals(28, fabricaDeNiveles.segundosDelNivel(2))
        assert.equals(10, fabricaDeNiveles.segundosDelNivel(50))
    }
}

// flujo del juego

describe "juego" {
        method completarNivelActual() {
        estudiante.ingredientesFaltantes().forEach({ ingrediente =>
            juego.nivelActual().recibirIngrediente(ingrediente)
        })
        juego.nivelActual().enviarPedido()
        juego.verificarNivel()
    }

    test "al completar el pedido, seguir pasa al proximo nivel" {
        juego.clickPantalla(game.at(0, 0))
        self.completarNivelActual()
        juego.clickPantalla(botonSeguir.position())
        assert.equals(escena2, juego.nivelActual().escena())
    }

    test "sin tiempo, reintentar repite el nivel" {
        juego.clickPantalla(game.at(0, 0))
        juego.nivelActual().restarTiempo(30)
        juego.verificarNivel()
        juego.clickPantalla(botonReintentar.position())
        assert.equals(escena1, juego.nivelActual().escena())
        assert.equals(30, juego.nivelActual().tiempoRestante())
    }
}

describe "un pedido de una sola receta" {
    const pedido = new Pedido(recetas = [cafeConMedialunas])

    test "pide los ingredientes de su receta" {
        assert.equals([cafe, medialunas], pedido.ingredientes())
        assert.that(pedido.pide(cafe))
        assert.notThat(pedido.pide(agua))
    }

    test "se describe con el nombre de la receta" {
        assert.equals("un café con medialunas", pedido.descripcion())
    }

    test "se completa cuando recibe todo" {
        assert.notThat(pedido.estaCompleto())
        pedido.agregar(cafe)
        assert.equals([medialunas], pedido.faltantes())
        pedido.agregar(medialunas)
        assert.that(pedido.estaCompleto())
    }

    test "reiniciar lo deja como nuevo" {
        pedido.agregar(cafe)
        pedido.reiniciar()
        assert.notThat(pedido.estaCompleto())
        assert.equals(2, pedido.faltantes().size())
    }
}

describe "un pedido combinado" {
    const pedido = new Pedido(recetas = [cafeConMedialunas, heladoOreoBanana])

    test "junta los ingredientes de todas sus recetas" {
        assert.equals(5, pedido.ingredientes().size())
        assert.that(pedido.pide(cafe))
        assert.that(pedido.pide(cremaOreo))
    }

    test "se describe nombrando las dos recetas" {
        assert.equals("un café con medialunas y un helado de crema Oreo y banana split con jarabe de chocolate", pedido.descripcion())
    }

    test "necesita todos los ingredientes de las dos recetas para estar completo" {
        cafeConMedialunas.ingredientes().forEach({ ing => pedido.agregar(ing) })
        assert.notThat(pedido.estaCompleto())
        heladoOreoBanana.ingredientes().forEach({ ing => pedido.agregar(ing) })
        assert.that(pedido.estaCompleto())
    }

    test "muestra una imagen por receta" {
        assert.equals(2, pedido.imagenes().size())
    }
}

describe "recetas que comparten un ingrediente" {
    const tostado = new Receta(nombre = "un tostado", rutaImagen = "juegor2/queso.png", ingredientes = [panInferior, queso])
    const pedido = new Pedido(recetas = [tostado, hamburguesaCompleta])

    test "el ingrediente compartido se pide una sola vez" {
        assert.equals(6, pedido.ingredientes().size())
    }

    test "entregarlo una vez alcanza para las dos recetas" {
        pedido.ingredientes().forEach({ ing => pedido.agregar(ing) })
        assert.that(pedido.estaCompleto())
    }
}